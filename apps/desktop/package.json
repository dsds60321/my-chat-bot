{
  "name": "my-chat-bot-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "tauri": "node scripts/tauri.mjs",
    "build:all": "export PATH=\"$(brew --prefix llvm)/bin:$(brew --prefix lld)/bin:$PATH\" && npm run tauri -- build && npm run tauri -- build --runner cargo-xwin --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-window-state": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8"
  }
}
